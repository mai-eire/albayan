// https://developers.cloudflare.com/workers/wrangler/configuration/
// Top level = production; "staging" is a separate Worker with its own D1 and R2.
// Both D1 databases live in WEUR: the school and its families are in Ireland.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "albayan",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": { "binding": "ASSETS", "directory": ".open-next/assets" },
  "services": [
    // Self-reference used by OpenNext's cache layer; the service name must match "name".
    { "binding": "WORKER_SELF_REFERENCE", "service": "albayan" },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "albayan",
      "database_id": "99f52e83-0957-45f4-8ab9-c40e7a75e880",
      "migrations_dir": "drizzle",
    },
  ],
  // EU jurisdiction, like the databases: the files are children's work and a school logo.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "albayan-files", "jurisdiction": "eu" }],
  "vars": {
    "EMAIL_TRANSPORT": "brevo",
    "EMAIL_FROM": "Al-Bayan <noreply@example.com>",
    "BETTER_AUTH_URL": "https://albayan.example.com",
  },
  // Secrets, set with `wrangler secret put <NAME> [--env staging]`:
  //   BETTER_AUTH_SECRET  BREVO_API_KEY
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "env": {
    "staging": {
      "name": "albayan-staging",
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "albayan-staging" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "albayan-staging",
          "database_id": "141866ba-5473-4fec-8d9b-0100a2575ac5",
          "migrations_dir": "drizzle",
        },
      ],
      "r2_buckets": [
        { "binding": "BUCKET", "bucket_name": "albayan-files-staging", "jurisdiction": "eu" },
      ],
      "vars": {
        "EMAIL_TRANSPORT": "brevo",
        "EMAIL_FROM": "Al-Bayan staging <noreply@mai.ie>",
        "BETTER_AUTH_URL": "https://albayan-staging.sweet-wave-5485.workers.dev",
      },
    },
  },
}
