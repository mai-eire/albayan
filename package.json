{
  "name": "albayan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "rm -rf .next/types .next-e2e/dev/types && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "pnpm check && pnpm test && pnpm test:e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply albayan --local",
    "db:seed": "tsx scripts/seed.mts",
    "bootstrap-admin": "tsx scripts/bootstrap-admin.mts",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime=false --strict-vars=false ./cloudflare-env.d.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@mantine/charts": "^9.6.1",
    "@mantine/core": "^9.6.1",
    "@mantine/dates": "^9.6.1",
    "@mantine/form": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "@mantine/modals": "^9.6.1",
    "@mantine/notifications": "^9.6.1",
    "@mantine/tiptap": "9.6.1",
    "@opennextjs/cloudflare": "^1.20.3",
    "@react-email/components": "^1.0.12",
    "@tabler/icons-react": "^3.46.0",
    "@tiptap/extension-link": "^3.31.3",
    "@tiptap/html": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "better-auth": "^1.7.5",
    "dayjs": "^1.11.23",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.4",
    "react": "^19.1.7",
    "react-dom": "^19.1.7",
    "recharts": "^3.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19.1.7",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10",
    "postcss": "^8.5.28",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3",
    "tsx": "^4.23.13",
    "typescript": "^5.7.4",
    "vitest": "^5.0.1",
    "wrangler": "^4.132.0"
  }
}
